# PostgreSQL only. These are local development example credentials.
DATABASE_URL=postgresql://wellio:wellio_local@127.0.0.1:5432/wellio
WELLIO_PUBLIC_ORIGIN=http://127.0.0.1:3100,http://localhost:3100
WELLIO_ATTACHMENTS_PATH=.data/attachments
# Set 1 when the frontend is served over HTTPS.
WELLIO_COOKIE_SECURE=0
# Server only; never prefix this with VITE_. Empty means search unavailable.
EXA_API_KEY=
# Knowledge embeddings only; separate from the Agent chat model.
# Fixed first-release model: qwen/qwen3-embedding-4b, 2560 dimensions.
OPENROUTER_API_KEY=
# CopilotKit BuiltInAgent runs in agent-runtime/. No CopilotKit cloud account.
WELLIO_AGENT_PORT=8001
WELLIO_API_BASE_URL=http://127.0.0.1:8000
# Use the same private random token in FastAPI and the Node service.
# The optional local stack launcher creates a token per launch automatically.
WELLIO_AGENT_TOKEN=
COPILOTKIT_TELEMETRY_DISABLED=true
# OpenRouter only. Empty API key means Agent unavailable.
OPENROUTER_API_KEY=
# Optional override; this model is the runtime default.
WELLIO_AI_MODEL=deepseek/deepseek-v4.1-flash
